# Database — Neon serverless Postgres (use the POOLED connection string on Vercel)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/arko?sslmode=require"

# NextAuth (v5)
# Generate a strong random AUTH_SECRET for production:
#   openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# S3 file storage (reuse the existing bucket + credentials)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
S3_BUCKET="your-bucket-name"
