# Database — reuse the SAME Supabase Postgres that Django uses, but Prisma lives in its own
# dedicated `arko` schema (Django keeps `public`). Use the IPv4 pooler (the direct
# db.<ref>.supabase.co host is IPv6-only). Note the pooler prefix may be aws-0 OR aws-1.
#   DATABASE_URL = transaction pooler :6543 (app runtime)  → needs pgbouncer=true
#   DIRECT_URL   = session pooler :5432 (migrations)
# Both carry schema=arko so Prisma never touches Django's public tables.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=arko"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?schema=arko"

# NextAuth (v5)
# Generate a strong random AUTH_SECRET for production:
#   openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage — S3-compatible (Django uses Supabase Storage). For AWS S3, omit S3_ENDPOINT.
S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_BUCKET="arko-attachments"
