# Database — reuse the SAME Postgres database Django uses (Supabase).
# Prisma creates its own tables (User, Task, ...) alongside Django's (auth_app_user, ...).
# From Supabase → Connect → ORM → Prisma. DATABASE_URL = transaction pooler (6543, app runtime);
# DIRECT_URL = direct/session connection (used for migrations).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# NextAuth (v5)
# Generate a strong random AUTH_SECRET for production:
#   openssl rand -base64 32
AUTH_SECRET="your-secret-key-here-change-in-production"
AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage — S3-compatible (Django uses Supabase Storage). For AWS S3, omit S3_ENDPOINT.
S3_ENDPOINT="https://your-project.supabase.co/storage/v1/s3"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_BUCKET="arko-attachments"
